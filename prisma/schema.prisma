generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Questionnaire {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  version     Int
  created_by  Int?
  created_at  DateTime  @default(now())
  surveys     Survey[]
  questions   Question[]
  access      QuestionnaireAccess[]

  @@map("questionnaires")
}

model Survey {
  id              Int       @id @default(autoincrement())
  questionnaire   Questionnaire? @relation(fields: [questionnaire_id], references: [id])
  questionnaire_id Int?
  title           String
  is_active       Boolean   @default(true)
  start_date      DateTime?
  end_date        DateTime?
  unique_link     String?
  created_by      Int?
  created_at      DateTime  @default(now())
  access          SurveyAccess[]
  survey_groups   SurveyGroup[]
  programs        SurveyProgram[]
  responses       SurveyResponse[]

  @@map("surveys")
}

model SurveyGroup {
  id              Int       @id @default(autoincrement())
  survey          Survey    @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  survey_id       Int
  name            String
  group_type      String?
  created_at      DateTime  @default(now())

  @@map("survey_groups")
}

model SurveyProgram {
  id              Int       @id @default(autoincrement())
  survey          Survey    @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  survey_id       Int
  program         Program   @relation(fields: [program_id], references: [id], onDelete: Cascade)
  program_id      Int
  created_at      DateTime  @default(now())

  @@unique([survey_id, program_id])
  @@map("survey_programs")
}

model SurveyResponse {
  id                  Int       @id @default(autoincrement())
  survey              Survey    @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  survey_id           Int
  participant_id      Int?
  device_fingerprint  String?
  started_at          DateTime  @default(now())
  completed_at        DateTime?
  time_spent_seconds  Int?
  status              String    @default("in_progress")
  created_at          DateTime  @default(now())
  question_response   QuestionResponse[]

  @@map("survey_responses")
}

model QuestionResponse {
  id              Int       @id @default(autoincrement())
  response        SurveyResponse @relation(fields: [response_id], references: [id], onDelete: Cascade)
  response_id     Int
  question        Question  @relation(fields: [question_id], references: [id], onDelete: Cascade)
  question_id     Int
  answer_data     Json?
  answered_at     DateTime  @default(now())

  @@map("question_responses")
}

model Question {
  id              Int       @id @default(autoincrement())
  questionnaire   Questionnaire @relation(fields: [questionnaire_id], references: [id])
  questionnaire_id Int
  question_text   String
  description     String?
  answer_placeholder String?
  question_type   String
  is_required     Boolean  @default(false)
  question_order  Int      @default(1)
  formatting      Json?
  created_at      DateTime @default(now())
  options         AnswerOption[]
  question_responses QuestionResponse[]

  @@map("questions")
}

model AnswerOption {
  id           Int      @id @default(autoincrement())
  question     Question @relation(fields: [question_id], references: [id])
  question_id  Int
  option_text  String
  option_order Int      @default(1)
  created_at   DateTime @default(now())

  @@map("answer_options")
}

model Program {
  id           Int      @id @default(autoincrement())
  code         String?
  name         String
  program_name String
  created_by   Int?
  created_at   DateTime @default(now())
  access       ProgramAccess[]
  survey_programs SurveyProgram[]

  @@map("programs")
}

model AuthUser {
  id                        Int                   @id @default(autoincrement())
  email                     String                @unique
  full_name                 String?
  password_hash             String
  role                      String                @default("admin")
  is_active                 Boolean               @default(true)
  created_at                DateTime              @default(now())
  updated_at                DateTime              @updatedAt
  sessions                  AuthSession[]
  reset_tokens              PasswordResetToken[]
  questionnaire_access      QuestionnaireAccess[] @relation("QuestionnaireAccessUser")
  survey_access             SurveyAccess[]        @relation("SurveyAccessUser")
  program_access            ProgramAccess[]       @relation("ProgramAccessUser")

  @@map("auth_users")
}

model AuthSession {
  id         Int      @id @default(autoincrement())
  user       AuthUser @relation(fields: [user_id], references: [id])
  user_id    Int
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@map("auth_sessions")
}

model PasswordResetToken {
  id         Int      @id @default(autoincrement())
  user       AuthUser @relation(fields: [user_id], references: [id])
  user_id    Int
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("password_reset_tokens")
}

model SurveyFingerprint {
  id          Int    @id @default(autoincrement())
  survey      Survey @relation(fields: [survey_id], references: [id])
  survey_id   Int
  fingerprint String
  cookie_id   String?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@map("survey_fingerprints")
  @@unique([survey_id, fingerprint])
}

model QuestionnaireAccess {
  id              Int         @id @default(autoincrement())
  questionnaire   Questionnaire @relation(fields: [questionnaire_id], references: [id], onDelete: Cascade)
  questionnaire_id Int
  user            AuthUser @relation("QuestionnaireAccessUser", fields: [user_id], references: [id], onDelete: Cascade)
  user_id         Int
  created_at      DateTime @default(now())

  @@unique([questionnaire_id, user_id])
  @@map("questionnaire_access")
}

model SurveyAccess {
  id              Int     @id @default(autoincrement())
  survey          Survey @relation(fields: [survey_id], references: [id], onDelete: Cascade)
  survey_id       Int
  user            AuthUser @relation("SurveyAccessUser", fields: [user_id], references: [id], onDelete: Cascade)
  user_id         Int
  created_at      DateTime @default(now())

  @@unique([survey_id, user_id])
  @@map("survey_access")
}

model ProgramAccess {
  id              Int     @id @default(autoincrement())
  program         Program @relation(fields: [program_id], references: [id], onDelete: Cascade)
  program_id      Int
  user            AuthUser @relation("ProgramAccessUser", fields: [user_id], references: [id], onDelete: Cascade)
  user_id         Int
  created_at      DateTime @default(now())

  @@unique([program_id, user_id])
  @@map("program_access")
}
